// Prisma schema for the Threaded Hope admin/storefront.
// Products are the source of truth for the catalog once a DATABASE_URL is set;
// without one, the app falls back to the static seed in src/data/products.ts.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooled, Prisma-tuned connection for the running app (Neon via Vercel).
  url = env("DATABASE_POSTGRES_PRISMA_URL")
  // Direct connection for migrations / schema sync (DDL).
  directUrl = env("DATABASE_POSTGRES_URL_NON_POOLING")
}

/// A sellable product. `variants` is JSON: [{ "name": "Color", "options": ["Sage"] }].
/// `collectionSlug` references a collection in src/data/collections.ts.
model Product {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  description    String
  priceCents     Int
  collectionSlug String // primary collection (breadcrumb, hue, related)
  collections    Json    @default("[]") // all collection slugs this product appears in
  image          String? // primary photo (Blob URL); falls back to a placeholder
  images         Json     @default("[]") // all photo URLs (gallery); image = images[0]
  variants       Json     @default("[]")
  featured       Boolean  @default(false)
  inStock        Boolean  @default(true)
  stock          Int? // null = untracked inventory (products without sizes)
  sizeStock      Json     @default("{}") // per-size counts, e.g. {"S":5,"M":0}; empty = not per-size
  optionStock    Json     @default("{}") // per-option counts for non-size groups, e.g. {"Color":{"Sage":3}}
  weightOz       Float? // shipping weight of one unit, in ounces (used for label rates)
  status         String   @default("active") // active (live) | draft (hidden) | archived
  productType    String? // free-form type, e.g. "Tote Bag"
  vendor         String? // maker/brand, e.g. "Threaded Hope"
  /// Manual position within each collection: {"faith-based": 3}. Missing = end.
  collectionOrder Json    @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([collectionSlug])
  @@index([featured])
  @@index([status])
}

/** Product collection (category). Seeded from the static list; managed in admin. */
model Collection {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  hue         Int      @default(145)
  featured    Boolean  @default(false)
  hidden      Boolean  @default(false)
  sortOrder   Int      @default(0)
  /// How products are ordered on the collection page. "manual" uses each
  /// product's collectionOrder position (drag-and-drop in admin).
  sortMode       String  @default("manual")
  seoTitle       String?
  seoDescription String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([hidden])
}

/// A newsletter signup. Drives the "Subscribed" column on Customers.
model Subscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  createdAt      DateTime  @default(now())
  unsubscribedAt DateTime?
}

/**
 * Automatic discount rule, evaluated against the cart at checkout (no code
 * needed). e.g. "3+ items → 10% off" (kind=quantity) or "$75+ → $10 off"
 * (kind=spend). Exactly one of percentOff / amountOffCents is set.
 */
model DiscountRule {
  id             String   @id @default(cuid())
  label          String
  kind           String // "quantity" (min item count) | "spend" (min subtotal, cents)
  threshold      Int
  percentOff     Int? // 1–100
  amountOffCents Int?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([active])
}

/** Small key/value store for app settings (e.g. the self-refreshing IG token). */
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// A paid order, recorded by the Stripe webhook on checkout.session.completed.
/// `items` is a JSON snapshot so history is stable even if products change.
model Order {
  id               String   @id @default(cuid())
  stripeSessionId  String   @unique
  /// Identity in an outside system (e.g. a Shopify order gid) so re-running an
  /// import updates rather than duplicates. Null for orders that started here.
  externalId       String?  @unique
  email            String?
  customerName     String?
  amountTotalCents Int
  currency         String   @default("usd")
  status           String   @default("paid")
  shipping         Json?
  items            Json     @default("[]")
  subtotalCents    Int? // pre-discount, pre-shipping line total (for receipts)
  discountCents    Int? // total discount applied (promo/auto)
  shippingCents    Int? // shipping charged
  taxCents         Int? // sales tax (Stripe Tax)
  isGift           Boolean  @default(false)
  giftMessage      String?
  pickup           Boolean  @default(false) // local pickup chosen at checkout
  source           String   @default("web") // "web" (Stripe) | "manual" (recorded in admin)
  notes            String? // free-form note (e.g. how a manual sale was paid)
  labelUrl         String?
  trackingNumber   String?
  carrier          String?
  fulfillmentStatus String  @default("unfulfilled") // unfulfilled | shipped | delivered
  shippedAt        DateTime?
  deliveredAt      DateTime?
  createdAt        DateTime @default(now())

  @@index([createdAt])
}

/// A single storefront page view, for the admin traffic dashboard.
model Pageview {
  id        String   @id @default(cuid())
  path      String
  referrer  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
}
