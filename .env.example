# ── Stripe payment keys ──
# Copy this file to `.env.local` and fill in your keys from
# https://dashboard.stripe.com/apikeys  (use TEST keys while developing).
# .env.local is gitignored and must never be committed.

# Secret key — starts with sk_test_ (test mode) or sk_live_ (live mode)
STRIPE_SECRET_KEY=sk_test_xxx

# Webhook signing secret — from `stripe listen` locally, or the Stripe
# Dashboard when you add a live webhook endpoint. Starts with whsec_
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Public base URL of your site (used to build return URLs). Optional locally
# (defaults to the request origin); set it in production to your real domain.
# NEXT_PUBLIC_BASE_URL=https://yourdomain.com

# ── Database (Postgres / Neon) ──
# Added automatically by the Vercel Neon integration (prefix: DATABASE).
# The app reads the pooled URL; schema sync/seed uses the non-pooling URL.
# Without these the app runs on the static catalog and the admin is disabled.
# DATABASE_POSTGRES_PRISMA_URL=postgres://...            # pooled (app)
# DATABASE_POSTGRES_URL_NON_POOLING=postgres://...       # direct (migrations)

# ── Vercel Blob (product photo uploads) ──
# From Vercel → Storage → Blob (enable the read-write token).
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# ── Admin ──
# Password that gates /admin. Choose any strong value.
# ADMIN_PASSWORD=change-me
