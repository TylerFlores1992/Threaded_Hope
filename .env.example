# ── Stripe payment keys ──
# Copy this file to `.env.local` and fill in your keys from
# https://dashboard.stripe.com/apikeys  (use TEST keys while developing).
# .env.local is gitignored and must never be committed.

# Secret key — starts with sk_test_ (test mode) or sk_live_ (live mode)
STRIPE_SECRET_KEY=sk_test_xxx

# Webhook signing secret — from `stripe listen` locally, or the Stripe
# Dashboard when you add a live webhook endpoint. Starts with whsec_
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Public base URL of your site (used to build return URLs). Optional locally
# (defaults to the request origin); set it in production to your real domain.
# NEXT_PUBLIC_BASE_URL=https://yourdomain.com

# ── Database (Postgres / Neon) ──
# Added automatically by the Vercel Neon integration (prefix: DATABASE).
# The app reads the pooled URL; schema sync/seed uses the non-pooling URL.
# Without these the app runs on the static catalog and the admin is disabled.
# DATABASE_POSTGRES_PRISMA_URL=postgres://...            # pooled (app)
# DATABASE_POSTGRES_URL_NON_POOLING=postgres://...       # direct (migrations)

# ── Vercel Blob (product photo uploads) ──
# From Vercel → Storage → Blob (enable the read-write token).
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# ── Admin ──
# Password that gates /admin. Choose any strong value.
# ADMIN_PASSWORD=change-me

# ── Instagram feed (home page strip) ──
# Long-lived Instagram Graph API user access token. When set, the home page
# shows your latest 6 posts (auto-refreshing hourly); without it, the strip
# falls back to recent product photos. See docs/SETUP.md.
# INSTAGRAM_ACCESS_TOKEN=IGQVxxx

# Secret that authenticates the scheduled token-refresh cron
# (/api/cron/refresh-instagram). Set the same value in Vercel; Vercel Cron sends
# it as a Bearer token. Any strong random string.
# CRON_SECRET=change-me

# ── Shipping labels (Shippo, optional) ──
# Shippo API token for buying/printing labels in the admin. shippo_test_… for
# free test labels, shippo_live_… for real postage. Without it the label page
# shows a setup guide. From apps.goshippo.com/settings/api.
# SHIPPO_API_KEY=shippo_test_xxx

# ── Transactional email (Resend, optional) ──
# Resend API key for order confirmation + shipping notification emails. Without
# it, emails are skipped (orders still record normally). From resend.com.
# RESEND_API_KEY=re_xxx
# From address for outgoing mail. The sending domain must be verified in Resend.
# EMAIL_FROM=Threaded Hope <orders@threaded-hope.com>

# ── Sales tax (optional) — pick ONE ──
# Automatic (Stripe Tax): exact per-destination tax, ~0.5% fee per taxed order.
# Requires Stripe Tax configured first (origin address + registrations) or
# checkout errors. Leave unset/0 until that's done.
# STRIPE_TAX_ENABLED=1
#
# OR a flat manual rate (free): create a Tax Rate in Stripe (e.g. 7.25%,
# "exclusive") and put its id here. Applied to line items. Ignored if
# STRIPE_TAX_ENABLED=1.
# STRIPE_TAX_RATE_ID=txr_xxx
